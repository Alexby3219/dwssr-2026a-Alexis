{
  "name": "dwssr-2026a-alexis",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#server/*.js": "./server/*.js",
    "#routes/*.js": "./server/routes/*.js",
    "#views/*.js": "./server/views/*.js",
    "#lib/*.js": "./server/lib/*.js"
  },
  "private": true,
  "scripts": {
    "start": "node ./server/bin/www.js",
    "dev": "nodemon ./server/bin/www.js",
    "dev:vite": "vite --host",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:vite\"",
    "build:front": "vite build",
    "preview": "npm run build:front && npm run start"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "hbs": "~4.0.4",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "vite": "^8.0.3"
  }
}
